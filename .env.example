# Copy to .env and fill in real values. .env is gitignored; this file is the
# template and must never hold a real credential.

DATABASE_URL=postgresql://user:password@localhost:5433/dbname

# RustFS speaks the S3 API; this must be the API endpoint, not the console.
RUSTFS_ENDPOINT_URL=http://localhost:9000
RUSTFS_ACCESS_KEY=changeme
RUSTFS_SECRET_KEY=changeme
RUSTFS_REGION=us-east-1
BUCKET_DOCUMENTS=documents
BUCKET_DERIVED=derived

MAX_UPLOAD_SIZE_MB=100
UPLOAD_CONCURRENCY=4

# The OpenAI-compatible text model (tables of contents, outlines).
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=changeme
LLM_MODEL=model-name

# Upstage embeddings (Embedding page). Backend-only; never log or commit it.
UPSTAGE_API_KEY=up_xxx
UPSTAGE_EMBEDDING_URL=https://api.upstage.ai/v1/embeddings
UPSTAGE_EMBEDDING_MODEL=solar-embedding-2-passage
UPSTAGE_QUERY_MODEL=solar-embedding-2-query

# Qdrant vector store. localhost when the backend runs on the host;
# http://qdrant:6333 from inside the docker network.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
